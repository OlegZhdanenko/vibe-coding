# ---------------------------------------------------------------------------
# Client (bundled into the browser build — public values only)
# ---------------------------------------------------------------------------
# Supabase project settings → API. The anon key is meant to be public; row
# level security is what protects the data.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional overrides
VITE_APP_NAME=Inboxly
# VITE_API_BASE_URL=/api

# ---------------------------------------------------------------------------
# Server (serverless functions only — never exposed to the browser)
# ---------------------------------------------------------------------------
# Which model writes the emails. Omit to auto-select: Anthropic if its key is
# present, then Gemini, then the offline writer. Set explicitly to pin one.
# EMAIL_PROVIDER=gemini

# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# https://aistudio.google.com/apikey — free tier, no card required
GEMINI_API_KEY=

# Same project as above; the service role key is only used to enforce quotas
# server-side. Keep it out of the client at all costs.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
